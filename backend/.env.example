# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection URI
# Example: mongodb://127.0.0.1:27017/designer_platform  or  mongodb+srv://...
MONGO_URI=

# JWT Authentication
JWT_SECRET=your_strong_random_jwt_secret
JWT_EXPIRE=30d

# Admin Seed Credentials — used by seed.js to create/maintain the admin account in MongoDB
# Run after setting these: npm run seed
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=YourStrongAdminPassword123

# Cloudinary Configuration (Reference Images & Media Storage)
# Obtain these credentials from your Cloudinary Dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
