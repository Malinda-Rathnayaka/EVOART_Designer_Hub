# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection URI (Leave empty to use automatic embedded in-memory MongoDB, or supply local / Atlas URI)
# Example: mongodb://127.0.0.1:27017/designer_bidding
MONGO_URI=

# JWT Authentication
JWT_SECRET=designer_platform_super_secret_jwt_key_2026
JWT_EXPIRE=30d

# Cloudinary Configuration (Reference Images & Media Storage)
# Obtain these credentials from your Cloudinary Dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
